{
  "manifest_version": 3,
  "name": "Custom new tab",
  "version": "1.1",
  "description": "Overrides the new tab page with a local homepage (search, shortcuts, news).",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "host_permissions": [
    "https://newsapi.org/*"
  ]
}